{
	"name": "project-garasi-lsp",
	"version": "0.0.1",
	"private": true,
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.2.0"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:reset": "prisma db push --force-reset && bun run seed all",
		"db:seed": "bun run src/lib/server/seed.ts",
		"seed": "bun run src/lib/server/seed.ts",
		"seed:user": "bun run src/lib/server/seed.ts user",
		"seed:garasi": "bun run src/lib/server/seed.ts garasi",
		"seed:all": "bun run src/lib/server/seed.ts all",
		"db:studio": "prisma studio"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.13.0",
		"@types/pg": "^8.23.1",
		"prisma": "7.10.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"dotenv": "^18.0.10",
		"pg": "^8.23.1"
	}
}
